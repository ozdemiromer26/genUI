{
  "name": "@genarch/ui",
  "version": "0.1.0",
  "description": "genarch ve genurban'ın ortak arayüz kütüphanesi: tasarım değişkenleri, stil, ikonlar, bileşenler",
  "license": "MIT",
  "author": "Ömer Özdemir",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ozdemiromer26/genui.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./css/*": "./css/*",
    "./tokens.json": "./src/tokens.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "css",
    "src/tokens.json"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "tokens": "node scripts/tokens.mjs",
    "check": "node scripts/tokens.mjs --check && node scripts/check-dist.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@changesets/cli": "2.29.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
